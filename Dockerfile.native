# syntax=docker/dockerfile:1
FROM rust:1.99.1-bookworm@sha256:c9155318d07341301a78b45ecdd81af2e43b8b297d64e8fd4c5e80d7735607c3 AS native
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates python3 pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
ENV SPIKE_ARTIFACTS=/build/artifacts CARGO_BIN=/usr/local/cargo/bin/cargo \
    CARGO_BUILD_JOBS=1 SPIKE_BUILD_PROFILE=release
WORKDIR /build/v-sdk
COPY . .
ARG TARGETARCH
RUN --mount=type=cache,id=temporal-v-${TARGETARCH}-rust-1-99-1,target=/build/artifacts/rust-target,sharing=locked \
    --mount=type=cache,id=temporal-v-${TARGETARCH}-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=temporal-v-${TARGETARCH}-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    bash scripts/build_native.sh && mkdir /export && \
    cp /build/artifacts/rust-target/release/libtemporalio_sdk_core_c_bridge.so \
       /build/artifacts/rust-target/release/libtemporal_v_payloads.so /export/ && \
    strip --strip-debug /export/*.so && \
    cp /build/v-sdk/locks/core-source.json /export/core-source.json
FROM scratch AS export
COPY --from=native /export/ /
