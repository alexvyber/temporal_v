+	mut groups := Decoder{ buf: [u8(0x0b), 0x13, 0x18, 0x07, 0x14, 0x0c, 0x10, 0x09] }
+	_, start := groups.read_tag()!
+	groups.skip(start)!
+	last, last_wire := groups.read_tag()!
+	assert last == 2 && last_wire == .varint
+	assert groups.read_varint()! == 9
