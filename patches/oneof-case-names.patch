+// A one-member V type alias is not a sum type, so it cannot use `is`.
+fn (g &Gen) oneof_condition(vname string, fld Field, value string) string {
+    loc := g.locs[vname] or { panic('missing message location: ${vname}') }
+    members := loc.msg.fields.filter(it.oneof == fld.oneof)
+    if members.len == 1 {
+        return 'true'
+    }
+    return '${value} is ${vname}_${camel(fld.name)}_Case'
 }
 
