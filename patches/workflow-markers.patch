diff --git a/crates/sdk-core/src/worker/workflow/machines/workflow_marker_state_machine.rs b/crates/sdk-core/src/worker/workflow/machines/workflow_marker_state_machine.rs
--- /dev/null
+++ b/crates/sdk-core/src/worker/workflow/machines/workflow_marker_state_machine.rs
@@ -0,0 +1,279 @@
+use super::{
+    EventInfo, HistEventData, NewMachineWithCommand, StateMachine, TransitionResult,
+    WFMachinesAdapter, WFMachinesError, fsm, workflow_machines::MachineResponse,
+};
+use crate::worker::workflow::{fatal, nondeterminism};
+use temporalio_common::protos::{
+    coresdk::workflow_commands::RecordWorkflowMarker,
+    temporal::api::{
+        command::v1::RecordMarkerCommandAttributes, enums::v1::CommandType,
+        history::v1::history_event,
+    },
+};
+
+fsm! {
+    pub(super) name WorkflowMarkerMachine;
+    command WorkflowMarkerCommand;
+    error WFMachinesError;
+    shared_state SharedState;
+
+    Created --(CommandScheduled, on_command_scheduled) --> CommandIssued;
+    CommandIssued --(MarkerRecorded(String), shared on_marker_recorded) --> Done;
+}
+
+pub(super) fn is_workflow_marker(name: &str) -> bool {
+    matches!(name, "SideEffect" | "MutableSideEffect")
+}
+
+pub(super) fn record_workflow_marker(
+    attributes: RecordWorkflowMarker,
+) -> Result<NewMachineWithCommand, WFMachinesError> {
+    if !is_workflow_marker(&attributes.marker_name) {
+        return Err(fatal!(
+            "Language code cannot record this marker name: {}",
+            attributes.marker_name
+        ));
+    }
+    for key in ["side-effect-id", "data"] {
+        if !attributes
+            .details
+            .get(key)
+            .is_some_and(|values| !values.payloads.is_empty())
+        {
+            return Err(fatal!("Workflow marker requires nonempty {key} payloads"));
+        }
+    }
+    let machine = WorkflowMarkerMachine::from_parts(
+        Created {}.into(),
+        SharedState {
+            marker_name: attributes.marker_name.clone(),
+        },
+    );
+    Ok(NewMachineWithCommand {
+        command: RecordMarkerCommandAttributes {
+            marker_name: attributes.marker_name,
+            details: attributes.details,
+            ..Default::default()
+        }
+        .into(),
+        machine: machine.into(),
+    })
+}
+
+#[derive(Clone)]
+pub(super) struct SharedState {
+    marker_name: String,
+}
+
+#[derive(Debug, derive_more::Display)]
+pub(super) enum WorkflowMarkerCommand {}
+
+#[derive(Default, Clone)]
+pub(super) struct Created {}
+#[derive(Default, Clone)]
+pub(super) struct CommandIssued {}
+#[derive(Default, Clone)]
+pub(super) struct Done {}
+
+impl Created {
+    pub(super) fn on_command_scheduled(self) -> WorkflowMarkerMachineTransition<CommandIssued> {
+        TransitionResult::default()
+    }
+}
+
+impl CommandIssued {
+    pub(super) fn on_marker_recorded(
+        self,
+        state: &mut SharedState,
+        marker_name: String,
+    ) -> WorkflowMarkerMachineTransition<Done> {
+        // Payloads can contain codec envelopes and external references. Language
+        // code validates identities after decoding; Core validates command order.
+        if marker_name != state.marker_name {
+            return TransitionResult::Err(nondeterminism!(
+                "Workflow marker {} does not match expected {}",
+                marker_name,
+                state.marker_name,
+            ));
+        }
+        TransitionResult::default()
+    }
+}
+
+impl WFMachinesAdapter for WorkflowMarkerMachine {
+    fn adapt_response(
+        &self,
+        _command: Self::Command,
+        _event: Option<EventInfo>,
+    ) -> Result<Vec<MachineResponse>, WFMachinesError> {
+        Err(fatal!(
+            "Workflow marker machines do not emit machine commands"
+        ))
+    }
+}
+
+impl TryFrom<CommandType> for WorkflowMarkerMachineEvents {
+    type Error = WFMachinesError;
+    fn try_from(command: CommandType) -> Result<Self, Self::Error> {
+        match command {
+            CommandType::RecordMarker => Ok(Self::CommandScheduled),
+            _ => Err(nondeterminism!(
+                "Workflow marker cannot handle command {command:?}"
+            )),
+        }
+    }
+}
+
+impl TryFrom<HistEventData> for WorkflowMarkerMachineEvents {
+    type Error = WFMachinesError;
+    fn try_from(event: HistEventData) -> Result<Self, Self::Error> {
+        match event.event.attributes {
+            Some(history_event::Attributes::MarkerRecordedEventAttributes(attributes)) => {
+                Ok(Self::MarkerRecorded(attributes.marker_name))
+            }
+            _ => Err(nondeterminism!(
+                "Workflow marker expected a MarkerRecorded event"
+            )),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{
+        replay::TestHistoryBuilder,
+        test_help::{
+            MockPollCfg, ResponseType, WorkerTestHelpers, build_mock_pollers, mock_worker,
+        },
+        worker::{client::mocks::mock_worker_client, workflow::machines::TemporalStateMachine},
+    };
+    use std::collections::HashMap;
+    use temporalio_common::protos::{
+        coresdk::{
+            workflow_activation::workflow_activation_job,
+            workflow_completion::WorkflowActivationCompletion,
+        },
+        temporal::api::{
+            common::v1::{Payload, Payloads},
+            enums::v1::EventType,
+            history::v1::{HistoryEvent, MarkerRecordedEventAttributes},
+        },
+    };
+
+    fn details() -> HashMap<String, Payloads> {
+        let opaque = Payloads {
+            payloads: vec![Payload {
+                metadata: HashMap::from([("encoding".to_string(), b"encrypted/custom".to_vec())]),
+                data: vec![0, 255, 128],
+                ..Default::default()
+            }],
+        };
+        HashMap::from([
+            ("side-effect-id".to_string(), opaque.clone()),
+            ("data".to_string(), opaque),
+        ])
+    }
+
+    fn attributes(name: &str) -> RecordWorkflowMarker {
+        RecordWorkflowMarker {
+            marker_name: name.to_string(),
+            details: details(),
+        }
+    }
+
+    fn event(name: &str) -> HistEventData {
+        HistEventData {
+            event: HistoryEvent {
+                event_type: EventType::MarkerRecorded as i32,
+                attributes: Some(history_event::Attributes::MarkerRecordedEventAttributes(
+                    MarkerRecordedEventAttributes {
+                        marker_name: name.to_string(),
+                        details: details(),
+                        ..Default::default()
+                    },
+                )),
+                ..Default::default()
+            },
+            replaying: true,
+            current_task_is_last_in_history: true,
+        }
+    }
+
+    #[test]
+    fn opaque_workflow_markers_record_and_validate_command_shape() {
+        for name in ["SideEffect", "MutableSideEffect"] {
+            let mut machine = record_workflow_marker(attributes(name)).unwrap().machine;
+            machine.handle_command(CommandType::RecordMarker).unwrap();
+            machine.handle_event(event(name)).unwrap();
+            assert!(machine.is_final_state());
+        }
+        let mut machine = record_workflow_marker(attributes("SideEffect"))
+            .unwrap()
+            .machine;
+        machine.handle_command(CommandType::RecordMarker).unwrap();
+        assert!(matches!(
+            machine.handle_event(event("MutableSideEffect")),
+            Err(WFMachinesError::Nondeterminism(_))
+        ));
+    }
+
+    #[test]
+    fn language_markers_cannot_impersonate_core_markers_or_omit_values() {
+        for name in ["", "core_patch", "core_local_activity", "UnknownMarker"] {
+            assert!(record_workflow_marker(attributes(name)).is_err());
+        }
+        for key in ["side-effect-id", "data"] {
+            let mut missing = attributes("SideEffect");
+            missing.details.remove(key);
+            assert!(record_workflow_marker(missing).is_err());
+            let mut empty = attributes("SideEffect");
+            empty.details.insert(key.to_string(), Payloads::default());
+            assert!(record_workflow_marker(empty).is_err());
+        }
+        let mut machine = record_workflow_marker(attributes("SideEffect"))
+            .unwrap()
+            .machine;
+        assert!(machine.handle_command(CommandType::StartTimer).is_err());
+    }
+
+    #[tokio::test]
+    async fn recorded_workflow_marker_is_available_before_replay_callbacks() {
+        let mut history = TestHistoryBuilder::default();
+        history.add_by_type(EventType::WorkflowExecutionStarted);
+        history.add_full_wf_task();
+        history.add(MarkerRecordedEventAttributes {
+            marker_name: "SideEffect".to_string(),
+            details: details(),
+            workflow_task_completed_event_id: 4,
+            ..Default::default()
+        });
+        history.add_we_signaled("finish", vec![]);
+        history.add_full_wf_task();
+        history.add_workflow_execution_completed();
+        let mock = MockPollCfg::from_resp_batches(
+            "side-effect-workflow",
+            history,
+            [ResponseType::ToTaskNum(2)],
+            mock_worker_client(),
+        );
+        let core = mock_worker(build_mock_pollers(mock));
+        let activation = core.poll_workflow_activation().await.unwrap();
+        assert!(activation.is_replaying);
+        assert!(activation.jobs.iter().any(|job| matches!(&job.variant,
+            Some(workflow_activation_job::Variant::NotifyWorkflowMarker(marker))
+            if marker.marker_name == "SideEffect" && marker.event_id == 5 && marker.details == details()
+        )));
+        core.complete_workflow_activation(WorkflowActivationCompletion::from_cmds(
+            activation.run_id,
+            vec![attributes("SideEffect").into()],
+        ))
+        .await
+        .unwrap();
+        let activation = core.poll_workflow_activation().await.unwrap();
+        assert!(activation.jobs.iter().any(|job| matches!(&job.variant,
+            Some(workflow_activation_job::Variant::SignalWorkflow(signal)) if signal.signal_name == "finish"
+        )));
+        core.complete_execution(&activation.run_id).await;
+    }
+}
