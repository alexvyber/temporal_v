+    #[test]
+    fn tracing_http_features_preserve_blocking_protobuf_metrics() {
+        use std::{
+            io::{Read, Write},
+            net::TcpListener,
+            thread,
+        };
+        use temporalio_common::telemetry::{
+            OtelCollectorOptions, OtlpProtocol, build_otlp_metric_exporter, metrics::CoreMeter,
+        };
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let address = listener.local_addr().unwrap();
+        listener.set_nonblocking(true).unwrap();
+        let receiver = thread::spawn(move || {
+            let deadline = Instant::now() + Duration::from_secs(5);
+            let mut stream = loop {
+                match listener.accept() {
+                    Ok((stream, _)) => break stream,
+                    Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                        assert!(Instant::now() < deadline, "metrics reader failed to export");
+                        thread::sleep(Duration::from_millis(10));
+                    }
+                    Err(error) => panic!("metrics receiver failed: {error}"),
+                }
+            };
+            stream
+                .set_read_timeout(Some(Duration::from_secs(3)))
+                .unwrap();
+            let mut bytes = Vec::new();
+            let header_end = loop {
+                let mut chunk = [0; 4096];
+                let size = stream.read(&mut chunk).unwrap();
+                assert!(
+                    size > 0 && bytes.len() < 65536,
+                    "invalid metrics HTTP headers"
+                );
+                bytes.extend_from_slice(&chunk[..size]);
+                if let Some(position) = bytes.windows(4).position(|part| part == b"\r\n\r\n") {
+                    break position + 4;
+                }
+            };
+            let headers = String::from_utf8_lossy(&bytes[..header_end]).to_lowercase();
+            assert!(
+                headers.contains("content-type: application/x-protobuf"),
+                "metrics protocol changed"
+            );
+            let size: usize = headers
+                .lines()
+                .find_map(|line| line.strip_prefix("content-length:"))
+                .unwrap()
+                .trim()
+                .parse()
+                .unwrap();
+            assert!(size > 0 && size < 1048576);
+            while bytes.len() < header_end + size {
+                let mut chunk = [0; 4096];
+                let size = stream.read(&mut chunk).unwrap();
+                assert!(size > 0);
+                bytes.extend_from_slice(&chunk[..size]);
+            }
+            stream
+                .write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
+                .unwrap();
+            bytes[header_end..header_end + size].to_vec()
+        });
+        let options = OtelCollectorOptions::builder()
+            .url(format!("http://{address}/v1/metrics").parse().unwrap())
+            .protocol(OtlpProtocol::Http)
+            .metric_periodicity(Duration::from_millis(100))
+            .build();
+        let meter = build_otlp_metric_exporter(options).unwrap();
+        let counter = meter.counter("temporal_trace_feature_guard".into());
+        let attributes = meter.new_attributes(Default::default());
+        counter.add(1, &attributes);
+        let body = receiver.join().unwrap();
+        assert!(
+            body.windows(b"temporal_trace_feature_guard".len())
+                .any(|part| part == b"temporal_trace_feature_guard")
+        );
+        drop(counter);
+        drop(attributes);
+        drop(meter);
+    }
