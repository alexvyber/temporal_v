+impl temporalio_client::worker::ActivitySlot for StandaloneActivitySlot {
+    fn schedule_activity(self: Box<Self>, task: PollActivityTaskQueueResponse) -> Result<(), anyhow::Error> {
+        if task.task_token.is_empty() { anyhow::bail!("Eager Activity response has no task token"); }
+        self.tx.send(TrackedPermittedTqResp { permit: self.permit, resp: task })
+            .map_err(|_| anyhow::anyhow!("Activity worker stopped before eager task dispatch"))?;
+        Ok(())
+    }
